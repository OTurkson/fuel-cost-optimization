# Copy these values into your shell environment when PostgreSQL/PostGIS is ready.
USE_POSTGIS=1
DB_NAME=fuel_stations
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
MAPBOX_ACCESS_TOKEN=replace-with-your-mapbox-token

# Keep this value out of source control in real environments.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
