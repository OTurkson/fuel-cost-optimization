# Copy these values into your shell environment when PostgreSQL/PostGIS is ready.
USE_POSTGIS=1
POSTGRES_DB=fuel_cost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keep this value out of source control in real environments.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
